{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceCuratorPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_mode",
    "source_scope_enforced",
    "persistence",
    "sources",
    "claims",
    "exclusions",
    "context_inspected_not_sources",
    "open_questions",
    "summary"
  ],
  "properties": {
    "source_mode": {
      "type": "string",
      "enum": ["github_open_source_research", "local_migration", "mixed_explicit"]
    },
    "source_scope_enforced": {
      "const": true
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "requested_path", "actual_path", "refused_paths"],
      "properties": {
        "authorized": {"type": "boolean"},
        "requested_path": {"type": ["string", "null"]},
        "actual_path": {"type": ["string", "null"]},
        "refused_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "context_inspected_not_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/context"}
    },
    "inspection_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inspectionReceipt"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "tag",
            "release",
            "package_version",
            "version",
            "unavailable",
            "unknown"
          ]
        },
        "value": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["unavailable", "unknown"]}}},
          "then": {"required": ["reason"]},
          "else": {"required": ["value"]}
        }
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["known", "unknown", "uncertain"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "url_or_path",
        "requested_ref",
        "observed_ref",
        "observed_identity",
        "content_sha256",
        "license",
        "primary_source",
        "relevance",
        "copied_content_allowed",
        "risks"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "url_or_path": {"type": "string", "minLength": 1},
        "requested_ref": {"type": "string", "minLength": 1},
        "observed_ref": {"type": "string", "minLength": 1},
        "observed_identity": {"$ref": "#/$defs/observedIdentity"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"$ref": "#/$defs/license"},
        "primary_source": {"type": "boolean"},
        "relevance": {"type": "string", "minLength": 1},
        "reusable_patterns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "copied_content_allowed": {"const": false},
        "risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "locator", "excerpt_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "locator": {"type": "string", "minLength": 1},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "classification", "statement", "citations"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "enum": ["fact", "inference"]},
        "statement": {"type": "string", "minLength": 1},
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/citation"}
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "inspectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
