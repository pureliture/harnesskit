{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarnessKit",
  "mainBinaryName": "harness-desktop",
  "version": "0.1.0",
  "identifier": "io.github.pureliture.harnesskit",
  "build": {
    "frontendDist": "target/frontend-dist",
    "beforeDevCommand": "echo dev",
    "beforeBuildCommand": "uv run --no-project --no-cache python scripts/package/prepare_install_runtime.py --repo-root .",
    "beforeBundleCommand": "uv run --no-project --no-cache python scripts/package/prepare_install_runtime.py --repo-root . --verify-only"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HarnessKit",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; media-src 'none'; worker-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "target/install-runtime/aarch64-apple-darwin/": "install-runtime/aarch64-apple-darwin/",
      "../schemas/install-target-contract-v1.json": "package-inputs/install-target-contract-v1.json",
      "target/package-build-inputs.json": "package-inputs/package-build-inputs.json",
      "resources/legal/THIRD_PARTY_NOTICES.html": "legal/THIRD_PARTY_NOTICES.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "../assets/packaging/macos/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
