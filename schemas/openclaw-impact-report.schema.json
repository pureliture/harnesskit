{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnesskit.dev/schemas/openclaw-impact-report.schema.json",
  "title": "OpenClaw Upstream Impact Report",
  "description": "Machine-readable report that OpenClaw consumes to detect upstream changes and generate review issues. Generated by HarnessKit provenance-impact-reviewer or external tooling.",
  "type": "object",
  "required": ["report_id", "generated_at", "source_change", "affected_components"],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Unique report identifier. Format: <source_id>-<new_short_sha>-<timestamp>",
      "pattern": "^[a-z0-9-]+-[a-f0-9]{7,}-\\d{14}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this report was generated"
    },
    "generator": {
      "type": "string",
      "description": "Tool that generated this report",
      "enum": ["harnesskit", "openclaw", "manual"]
    },
    "source_change": {
      "type": "object",
      "required": ["source_id", "old_snapshot", "new_snapshot", "change_type"],
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Reference to sources/registry.yml entry"
        },
        "old_snapshot": {
          "type": "object",
          "required": ["commit", "snapshot_id", "observed_at"],
          "properties": {
            "commit": { "type": "string", "description": "Previous commit SHA" },
            "snapshot_id": { "type": "string", "description": "Previous snapshot identifier" },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        },
        "new_snapshot": {
          "type": "object",
          "required": ["commit", "snapshot_id", "observed_at"],
          "properties": {
            "commit": { "type": "string", "description": "New commit SHA" },
            "snapshot_id": { "type": "string", "description": "New snapshot identifier" },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        },
        "diff_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to compare diff (GitHub, etc.)"
        },
        "change_type": {
          "type": "string",
          "enum": ["commit_changed", "tag_changed", "branch_head_moved", "license_changed", "file_added", "file_removed", "file_modified"],
          "description": "Type of upstream change detected"
        },
        "changed_files": {
          "type": "array",
          "description": "List of files changed in upstream (if known)",
          "items": {
            "type": "object",
            "required": ["path", "change_kind"],
            "properties": {
              "path": { "type": "string" },
              "change_kind": { "type": "string", "enum": ["added", "modified", "removed", "renamed"] },
              "old_path": { "type": "string", "description": "For renamed files" }
            }
          }
        }
      }
    },
    "affected_components": {
      "type": "array",
      "description": "Components in HarnessKit that reference the changed source",
      "items": {
        "type": "object",
        "required": ["component_id", "component_path", "impact_level", "provenance_refs"],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|workflow)\\.[a-z][a-z0-9-]+$",
            "description": "Canonical component identifier from components/registry.yml"
          },
          "component_path": {
            "type": "string",
            "description": "Relative path to component directory"
          },
          "component_kind": {
            "type": "string",
            "enum": ["skill", "agent", "hook", "rule", "command", "workflow"]
          },
          "impact_level": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "How likely the upstream change affects this component's behavior"
          },
          "impact_reason": {
            "type": "string",
            "description": "Human-readable explanation of why this component is affected"
          },
          "provenance_refs": {
            "type": "array",
            "description": "Which provenance entries link this component to the changed source",
            "items": {
              "type": "object",
              "required": ["source_id", "source_path", "influence"],
              "properties": {
                "source_id": { "type": "string" },
                "source_path": { "type": "string" },
                "influence": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of influence items from provenance.map.yml"
                },
                "copied_content": { "type": "boolean" },
                "adapted_content": { "type": "boolean" }
              }
            }
          },
          "current_status": {
            "type": "string",
            "enum": ["draft", "review", "stable", "deprecated"]
          },
          "review_state": {
            "type": "object",
            "properties": {
              "upstream_sync": { "type": "string", "enum": ["clean", "stale", "pending", "unknown"] },
              "human_review": { "type": "string", "enum": ["pending", "approved", "rejected"] },
              "license_review": { "type": "string", "enum": ["pending", "approved", "rejected"] }
            }
          }
        }
      }
    },
    "suggested_issues": {
      "type": "array",
      "description": "Suggested issues that OpenClaw (or a human) can create",
      "items": {
        "type": "object",
        "required": ["issue_type", "title", "body_template_ref", "affected_component_ids"],
        "properties": {
          "issue_type": {
            "type": "string",
            "enum": ["upstream-impact", "license-review", "component-sync", "security-audit"]
          },
          "title": {
            "type": "string",
            "description": "Suggested issue title. May contain placeholders like {source_id}, {component_id}"
          },
          "body_template_ref": {
            "type": "string",
            "description": "Reference to template file in components/reports/templates/"
          },
          "priority": {
            "type": "string",
            "enum": ["p0", "p1", "p2", "p3"]
          },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "affected_component_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "template_variables": {
            "type": "object",
            "description": "Key-value pairs to fill template placeholders",
            "additionalProperties": true
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes for human reviewers"
    }
  }
}
