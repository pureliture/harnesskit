{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnesskit.dev/schemas/install-plan.schema.json",
  "title": "HarnessKit Install Plan Schema",
  "description": "A dry-run/apply plan that materializes a profile into project-local AI CLI runtime surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "profile_id",
    "scope",
    "mode",
    "targets",
    "components",
    "artifacts",
    "runtime_surfaces",
    "activation_gates"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^harnesskit\\.install-plan\\.[a-z][a-z0-9.-]+$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^harnesskit\\.profile\\.[a-z][a-z0-9-]+$"
    },
    "scope": {
      "type": "string",
      "enum": ["project", "user"]
    },
    "mode": {
      "type": "string",
      "enum": ["dry-run", "apply", "verify"]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
      },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|workflow)\\.[a-z][a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "component_contracts": {
      "type": "array",
      "description": "Optional scope-aware component contract metadata selected for this install plan. Artifacts remain the exact materialization list; this section carries contract/evidence context for reviewers and evaluators.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "kind", "scope", "evidence_status"],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^harnesskit\\.(skill|agent|hook|rule)\\.[a-z][a-z0-9-]+$"
          },
          "kind": {
            "type": "string",
            "enum": ["skill", "agent", "hook", "rule"]
          },
          "subtype": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "scope": {
            "type": "string",
            "enum": ["project", "user"]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "ownership": {
            "$ref": "#/definitions/ownership"
          },
          "runtime_contract": {
            "type": "object"
          },
          "evidence_status": {
            "$ref": "#/definitions/evidence_status"
          }
        }
      }
    },
    "runtime_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "path", "source"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))((\\.harnesskit|\\.claude|\\.codex|\\.agents|acli)(?:/.*)?|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|\\$\\{CODEX_HOME:-\\$HOME/\\.codex\\}/hooks\\.json)$"
          },
          "source": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))dist/(project|claude|codex|gemini|antigravity-cli|antigravity)/.+$",
            "description": "Source output or config surface that should materialize here."
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Exact generated files selected by the profile and intended for materialization.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "target", "source", "destination"],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|workflow)\\.[a-z][a-z0-9-]+$"
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|workflow)\\.[a-z][a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "target": {
            "type": "string",
            "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
          },
          "source": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))dist/(project|claude|codex|gemini|antigravity-cli|antigravity)/.+$"
          },
          "destination": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))((\\.harnesskit|\\.claude|\\.codex|\\.agents|acli)/.+|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|\\$\\{CODEX_HOME:-\\$HOME/\\.codex\\}/hooks\\.json)$"
          },
          "merge_strategy": {
            "type": "string",
            "enum": ["managed-block", "json-deep-merge"]
          },
          "begin_marker": {
            "type": "string",
            "minLength": 1
          },
          "end_marker": {
            "type": "string",
            "minLength": 1
          },
          "json_merge_key": {
            "type": "string",
            "enum": ["claude-settings-hooks", "codex-hooks"]
          },
          "scope": {
            "type": "string",
            "enum": ["project", "user"]
          },
          "ownership": {
            "$ref": "#/definitions/ownership"
          },
          "runtime_contract": {
            "type": "object"
          },
          "evidence_status": {
            "$ref": "#/definitions/evidence_status"
          }
        }
      }
    },
    "activation_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "reason", "required_before_apply", "required_before_runtime"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "target": {
            "type": "string",
            "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
          },
          "reason": {
            "type": "string"
          },
          "required_before_apply": {
            "type": "boolean"
          },
          "required_before_runtime": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "definitions": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "merge_policy"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["path", "managed-block", "managed-hook-group", "managed-config-key"]
        },
        "managed_group_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "managed_block_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "merge_policy": {
          "type": "string",
          "enum": ["full-path-overwrite", "managed-block", "json-deep-merge", "managed-key-merge"]
        },
        "preserve_foreign_entries": {
          "type": "boolean"
        }
      }
    },
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["runtime_supported", "doc_supported", "build_only", "pending_probe", "unsupported"]
        },
        "reason": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
