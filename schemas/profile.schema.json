{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnesskit.dev/schemas/profile.schema.json",
  "title": "HarnessKit Profile Schema",
  "description": "A profile directly selects components for a concrete usage mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "status", "title", "summary", "components", "install_policy"],
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Canonical profile identifier. Format: harnesskit.profile.<name>",
      "pattern": "^harnesskit\\.profile\\.[a-z][a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "stable", "deprecated", "archived"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "description": "Component ids selected by this profile.",
      "items": {
        "type": "string",
        "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|workflow)\\.[a-z][a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli"]
      },
      "uniqueItems": true
    },
    "install_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_scope", "allowed_scopes", "activation_policy"],
      "properties": {
        "default_scope": {
          "type": "string",
          "enum": ["project", "workspace", "user"]
        },
        "allowed_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["project", "workspace", "user"]
          },
          "uniqueItems": true
        },
        "activation_policy": {
          "type": "string",
          "enum": ["none", "manual", "deferred"]
        }
      }
    }
  }
}
