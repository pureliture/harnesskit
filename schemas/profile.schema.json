{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnesskit.dev/schemas/profile.schema.json",
  "title": "HarnessKit Profile Schema",
  "description": "A profile directly selects components for a concrete usage mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "status", "title", "summary", "components", "install_policy"],
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Canonical profile identifier. Format: harnesskit.profile.<name>",
      "pattern": "^harnesskit\\.profile\\.[a-z][a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "stable", "deprecated", "archived"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "description": "Installable component ids (or composite ids) selected by this profile. Workflow identities are relation definitions and cannot be Profile members. Composite ids are expanded to their member components at install time.",
      "items": {
        "type": "string",
        "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|composite)\\.[a-z][a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["project", "claude", "codex", "gemini", "antigravity", "antigravity-cli", "hermes"]
      },
      "uniqueItems": true
    },
    "install_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_scope", "allowed_scopes", "activation_policy"],
      "properties": {
        "default_scope": {
          "type": "string",
          "enum": ["project", "user"]
        },
        "allowed_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["project", "user"]
          },
          "uniqueItems": true
        },
        "activation_policy": {
          "type": "string",
          "enum": ["none", "manual", "deferred"]
        },
        "scope_components": {
          "type": "object",
          "description": "Components selected only at a specific install scope (e.g. user-only optimal-response). Resolved by scripts/install/plan.py in addition to the unconditional components list.",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|composite)\\.[a-z][a-z0-9-]+$"
              },
              "uniqueItems": true
            },
            "user": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^harnesskit\\.(skill|agent|hook|rule|command|composite)\\.[a-z][a-z0-9-]+$"
              },
              "uniqueItems": true
            }
          }
        },
        "retired_codex_agent_registrations": {
          "type": "object",
          "description": "Codex agent registrations from prior HarnessKit releases that may be safely pruned only at the declared install scope.",
          "additionalProperties": false,
          "properties": {
            "project": {
              "$ref": "#/definitions/retired_codex_agent_registration_list"
            },
            "user": {
              "$ref": "#/definitions/retired_codex_agent_registration_list"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "retired_codex_agent_registration_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "config_file"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "config_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
